{
  "name": "dsh-wiserec-cli",
  "version": "0.0.1",
  "description": "本插件需配合 WiseRec CLI 使用。请先完成 CLI 配置并申请使用权限，审批通过后即可使用。平台会记录使用情况。插件在 DeepSeek Harness 中按会话绑定环境与业务，并在宿主运行期间自动保活、显示会话标题和登录状态。",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "config.js",
    "config.json",
    "logging.js",
    "runner.js",
    "session-status.js",
    "session-title.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
