{
  "name": "dsh-wiserec-cli",
  "version": "0.1.1",
  "description": "WiseRec CLI keepalive scheduler for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "config.js",
    "config.json",
    "logging.js",
    "runner.js",
    "session-status.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
