# Copy to docker/service.env, chmod 600; never commit real credentials.
# 127.0.0.1 here would refer to the application container, not the host.
DATABASE_URL=mysql+pymysql://cli_access:CHANGE_ME@mysql.internal:3306/cli_access?charset=utf8mb4
COOKIE_SECURE=false
TLS_CERT_FILE=
TLS_KEY_FILE=
# Trust only your proxy's actual address/network. Empty disables proxy trust.
FORWARDED_ALLOW_IPS=
