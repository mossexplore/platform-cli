# MySQL 8.x；密码中的 @ / : 等字符需要 URL 编码。
DATABASE_URL=mysql+pymysql://cli_access:CHANGE_ME@127.0.0.1:3306/cli_access?charset=utf8mb4
# 内网 HTTP 设置 false；通过 HTTPS 访问时设置 true。
COOKIE_SECURE=false
# 平台使用企业 CA 时，配置包含企业 CA 的信任证书包（可选）。
# SSL_CERT_FILE=/etc/cli-access/ca-bundle.pem

# 默认内网 HTTP，无需证书；可选 HTTPS 时填写证书和私钥路径。
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8008
TLS_CERT_FILE=
TLS_KEY_FILE=
# 若使用现有 Nginx：LISTEN_HOST=127.0.0.1，清空两个 TLS 路径。
